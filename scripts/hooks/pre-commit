#!/bin/sh
# superagency.skill is generated by CI, never by hand. Staging it locally is
# almost always an accident — the build is deterministic, so if your rebuild
# matches what CI produced there is no diff to stage in the first place.
if git diff --cached --name-only | grep -qx 'superagency.skill'; then
  cat >&2 <<'MSG'
error: superagency.skill is generated — don't commit it by hand.

  CI rebuilds it from superagency/ and commits it to your PR branch.
  Just commit your source changes and push.

  To unstage it:      git restore --staged superagency.skill
  To bypass this once: git commit --no-verify
MSG
  exit 1
fi
